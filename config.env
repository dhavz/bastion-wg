# Bastion — VPN server settings. Edit BEFORE running ./setup.sh.
# Changing these after the server exists does not reconfigure it.

DROPLET_NAME="bastion-vpn-01"
REGION="tor1"                 # DigitalOcean region slug (tor1 = Toronto). `doctl compute region list`
SIZE="s-2vcpu-2gb"            # $18/mo, 3 TB transfer. Bigger: s-2vcpu-4gb ($24, 4 TB), s-4vcpu-8gb ($48, 5 TB)
IMAGE="ubuntu-24-04-x64"

WG_PORT="51820"               # UDP port WireGuard listens on
CLIENT_PORT="443"             # UDP port written into user profiles; the server forwards it to WG_PORT.
                              # 443 gets through more hotel/guest networks. WG_PORT keeps working too.
WG_NET="10.8.0"               # VPN subnet is ${WG_NET}.0/24, server is .1
CLIENT_DNS="1.1.1.1, 1.0.0.1" # public DNS servers used for lookups
LOG_WEBSITES="yes"            # yes: the server answers users' DNS itself and records the domain names
                              #      each user looks up (profiles then use the server as their DNS).
                              # no:  profiles use CLIENT_DNS directly and nothing is recorded.
                              # After changing this, run ./setup.sh and hand out the refreshed profiles.
BACKUP_KEEP_DAYS="30"         # the portal backs the server up every night and deletes backups older than this
SITE_RETENTION_DAYS="30"      # days of website log to keep; older entries are deleted automatically
USAGE_RETENTION_DAYS="30"     # days of per-user usage, connection log and portal admin log to keep;
                              # anything older is deleted automatically

TAG="bastion-vpn"             # DO tag; the cloud firewall attaches to it
FIREWALL_NAME="bastion-fw"
DO_SSH_KEY_NAME="bastion-key"
